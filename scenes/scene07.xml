				</Triangle>
			</Primitives>
		</SceneObject>

		<!-- right wall -->
		<SceneObject>
			<Transform>
				<Position>1, 0.75, 0</Position>
				<Rotation>0, -90, 0</Rotation>
				<Scale>1</Scale>
			</Transform>
			<Primitives>
				<Triangle>
					<Vertex>-1, -0.75, 0</Vertex>
