<Scene>
	<Camera>
		<Position>0, 0.6, -2.58</Position>
		<Target>0, 0.61, 3</Target>
		<Up>0, 1, 0</Up>
		<NearZ>0.1</NearZ>
		<FarZ>1000</FarZ>
		<Fov>45</Fov>
	</Camera>

	<SceneObjects>
		<!-- left sphere -->
		<SceneObject>
			<Transform>
				<Position>-0.4, 0.3, 0.3</Position>
				<Rotation>0, 0, 0</Rotation>
				<Scale>1</Scale>
			</Transform>
			<Primitives>
				<Sphere>
					<Radius>0.3</Radius>
				</Sphere>
			</Primitives>
		</SceneObject>

		<!-- right sphere -->
		<SceneObject>
			<Transform>
				<Position>0.4, 0.3, -0.3</Position>
				<Rotation>0, 0, 0</Rotation>
				<Scale>1</Scale>
			</Transform>
			<Primitives>
				<Sphere>
					<Radius>0.3</Radius>
				</Sphere>
			</Primitives>
		</SceneObject>

		<!-- ground -->
		<SceneObject>
			<Transform>
				<Position>0, 0, 0</Position>
				<Rotation>-90, 0, 0</Rotation>
				<Scale>1</Scale>
