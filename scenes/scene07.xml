        <PointLight>
			<Position>0, 1, 0</Position>
			<Intensity>0.3, 0.3, 1.1</Intensity>
            <Attenuations>1, 0, 0</Attenuations>
        </PointLight>
		 
        <SpotLight>
			<Position>-0.8, 0.9, 0</Position>
			<Direction>2, -1, 0</Direction>
            <Intensity>1.2, 0.8, 0</Intensity>
            <InnerAngle>10</InnerAngle>
            <OuterAngle>60</OuterAngle>
            <Attenuations>1, 0, 0</Attenuations>
        </SpotLight>
	 </Lights>
