					<Vertex>1, 1, 0</Vertex>
					<Vertex>-1, 1, 0</Vertex>
				</Triangle>
			</Primitives>
		</SceneObject>

		<!-- ceiling -->
		<SceneObject>
			<Transform>
				<Position>0, 1.5, 0</Position>
				<Rotation>90, 0, 0</Rotation>
				<Scale>1</Scale>
